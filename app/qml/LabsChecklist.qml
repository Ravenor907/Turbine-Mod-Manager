import QtQuick

// Labs' checklist: things to confirm on the device, what the build server can't check. Each item has its id, its
// title, how to try it and what should happen (expect). Main.qml's labsItems; Settings, Labs lists them with Works,
// Problem and Not tested.
QtObject {
    readonly property var items: [
        // Modded launches through Steam, Seamless Co-op, Edit settings, the bar.
        { id: "steam-me3", title: "Elden Ring with mods in Game Mode", how: "Game Mode: turn on a mod for Elden Ring and press Play. Do the one step it shows (pick Turbine (mods) in Steam), then press Check again.",
          expect: "The game starts with the mod, offline, and shows in Game Mode (not Steam's blank launching screen). Steam's own Play button starts it with mods too. With every mod off, it starts online as usual." },
        { id: "steam-plain", title: "Play without mods after the step", how: "With Steam's Launch Options set and mods on: Play options, Play without mods.",
          expect: "Elden Ring starts normally, with its anti-cheat. The next Play starts it with mods." },
        { id: "coop-play", title: "Play Seamless Co-op", how: "Elden Ring with Seamless Co-op: press Play and pick Play Seamless Co-op. With no session password set, its settings open first.",
          expect: "Seamless Co-op starts with your password and its own co-op save. Play with mods starts the modded game solo." },
        { id: "edit-settings", title: "Edit settings with the controller", how: "Press X on a mod with an .ini or .cfg file, then Edit settings. Change an On or Off setting, a number and a text (with Steam's keyboard).",
          expect: "Each change saves automatically and the game uses the new values. Reset to default puts back the mod's own values; a mod update keeps yours." },
        { id: "launch-check", title: "When a game doesn't start", how: "Press Play on a game that can't start (for example, Elden Ring with mods after its Proton is uninstalled).",
          expect: "About 20 seconds later, a sheet says the game didn't start, with what Turbine's Steam tool said. Its choices: Play without mods, Activity log, Why won't it start? If the game shows up late, the sheet closes automatically." },
        // Anti-cheat games.
        { id: "ac-me3", title: "Elden Ring with mods through Mod Engine 3", how: "Elden Ring (or Nightreign, Armored Core VI): add a mod, press Play and pick Turn it off for mods. The first time, Turbine gets Mod Engine 3.",
          expect: "The game starts offline with the mod and no anti-cheat. The game folder has no new files, and your normal save is untouched (mods use a separate save)." },
        { id: "ac-original", title: "Normal launch after mods", how: "After playing with mods, turn every mod off and press Play (or use Play without mods).",
          expect: "Steam starts the game the normal way, with its anti-cheat, and online play works. Steam's Verify finds nothing to repair." },
        { id: "ac-seamless", title: "Seamless Co-op through Mod Engine 3", how: "Elden Ring: Game menu, Get Seamless Co-op, then press Play.",
          expect: "Seamless Co-op starts with the game and uses its own co-op saves. Turning it off in My mods takes it out." },
        { id: "ac-halo", title: "Halo MCC guide", how: "Halo MCC: add a mod and press Play.",
          expect: "The Before you play check says to pick Anti-Cheat Disabled (Mods and Limited Services) in Steam's Play menu. The mod works there." },
        { id: "ac-refuse", title: "Online-only games refuse mods", how: "Open Dead by Daylight, Apex Legends or Destiny 2 and try Add from Downloads.",
          expect: "Turbine says the game needs its anti-cheat and adds nothing." },
        { id: "pad-quiet", title: "Controller stays quiet after a game", how: "Play a game, press buttons as you quit it, then come back to Turbine.",
          expect: "Buttons pressed in the game do nothing in Turbine." },
        { id: "proton-bepinex", title: "Proton setting on a BepInEx game", how: "Add a BepInEx mod to Valheim, Lethal Company or Risk of Rain 2, then press Play.",
          expect: "The check before Play says Turbine turns BepInEx on in Proton. The game starts with the mod working." },
        { id: "running-check", title: "Game still running", how: "With a BepInEx game running, switch back to Turbine and press Play.",
          expect: "Turbine says the game is still running and changes nothing until you close it." },
        { id: "nexus-keyless", title: "Get mods without a Nexus key", how: "Settings, Labs, Nexus without a key: press Check. Then open Get mods in Skyrim Special Edition, The Witcher 3 or Cyberpunk 2077.",
          expect: "The check says Nexus answered. Get mods shows the game's mods with pictures, no key needed." },
        { id: "nexus-inside", title: "Nexus inside Turbine", how: "Game Mode: open a mod's page and press A on Get it on Nexus. Sign in, then press Slow download with the pointer (right stick to move, RT to click).",
          expect: "The file's page opens full screen in Turbine. After Nexus's wait, the pill shows the download, then Added. The page closes automatically and Play is highlighted." },
        { id: "nexus-signed-in", title: "Nexus keeps you signed in", how: "Sign in on the Nexus page in Turbine. Close Turbine, open it and open a mod's Nexus page.",
          expect: "You're still signed in." },
        { id: "nexus-google", title: "Google sign-in through Chrome", how: "With the browser helper set up in Chrome, press Google sign-in on the Nexus page, then sign in with Google in Chrome.",
          expect: "Turbine comes back to the front and says Signed in to Nexus. The page shows you signed in." },
        { id: "nexus-pad", title: "Controller on the Nexus page", how: "Try the D-pad between links, A on a link, Y in a text field, B to go back, LB and RB for the tabs and VIEW for the wheel.",
          expect: "Each does what the legend says. Steam's keyboard opens in a text field, and the pointer never hides." },
        { id: "game-mods-folder", title: "Slow download with no Save box (My browser)", how: "Desktop Mode, Open Nexus in: My browser, with the browser helper set up in Chrome. Press Slow download on a mod's file page.",
          expect: "No Save box opens. The file lands in Downloads/Game Mods/<game>, and Turbine adds it to that game." },
        { id: "desktop-pad", title: "Controller in Desktop Mode", how: "Desktop Mode with Steam running: use Turbine with the controller.",
          expect: "Buttons work (through Steam's mouse and keyboard if Turbine can't see the controller), and nothing says no controller was found." },
        { id: "text-size", title: "Interface size in Game Mode", how: "In Game Mode, look at every page at each Interface size from 50% to 150% (tap - and +, D-pad Left and Right, or A for the list).",
          expect: "Everything is readable, and nothing is cut off or overlapping." },
        { id: "add-downloads", title: "Add mods from Downloads", how: "Put a mod's zip in Downloads, then press VIEW and pick Add from Downloads.",
          expect: "The mod shows in the list, turned on, with its name and version." },
        { id: "auto-apply", title: "Changes apply without Play", how: "Turn a mod on or off, wait 5 seconds, close Turbine and start the game from your Steam library.",
          expect: "The game has the change without pressing Play in Turbine." },
        { id: "uninstall-undo", title: "Uninstall and put back", how: "Uninstall a mod from its options (X), then press A on its dimmed row.",
          expect: "The row stays dimmed for 8 seconds, and A puts the mod back in the same place. After that, it waits in Removed mods at the bottom of the list." },
        { id: "play-original", title: "Play without mods", how: "VIEW, Game menu, Play without mods.",
          expect: "The game starts with no mods. The mods stay in Turbine and go back in at the next Play." },
        { id: "restore", title: "Go back to a setup that worked", how: "Play with mods and change some. Then VIEW, Game menu, Go back to a setup that worked.",
          expect: "The mods go back to how they were the last time you played." },
        { id: "sd-card", title: "Game on the SD card", how: "Add a mod to a game on the SD card and play it. Then try with the card out.",
          expect: "The mod works. With the card out, Turbine says the game is offline, never that mods are gone." },
        { id: "heroic-play", title: "Play a Heroic game", how: "Pick an Epic or GOG game from Heroic and press Play.",
          expect: "Heroic starts the game with the mods in place. In Game Mode, check that the game shows on screen (Turbine says how to switch to it)." },
        { id: "seasonal", title: "Seasonal leaves and snow", how: "Settings > Look > Seasonal: Autumn, then Snow. Try Amount and Size.",
          expect: "They fall smoothly behind the panels and stop while a game runs." },
        { id: "quick-report", title: "Screenshot and report", how: "With Labs on, hold VIEW for 7 seconds.",
          expect: "A brass ring fills, then a screenshot and a report land in Downloads. The report is also on the clipboard, ready to paste." },
        { id: "ts-install", title: "Get a mod from Thunderstore", how: "Valheim, Lethal Company or Risk of Rain 2: open Get mods, open a mod and press A to get it.",
          expect: "It downloads with its progress on the status line and the rail's ring, then shows in My mods with the mods it needs." },
        { id: "loader-install", title: "Install a mod loader", how: "Turn on a mod that needs a loader (SKSE, BepInEx or SMAPI), then press A on Install in the prompt.",
          expect: "The loader downloads from its official site and shows as a mod. The Needs badges go away." },
        { id: "fomod", title: "Installer choices (FOMOD)", how: "Add a Skyrim Special Edition mod that has an installer, from Get mods or Downloads.",
          expect: "One question per page, with pictures, and B goes back. Only the files of your choices go in." },
        { id: "load-order", title: "Load order", how: "Skyrim Special Edition, Load order tab: turn a plugin off, move one (X, Move), then pick Sort automatically.",
          expect: "The game loads the plugins in that order. Masters stay first, and missing masters are named." },
        { id: "ts-code", title: "Thunderstore code", how: "Lethal Company or another Thunderstore game, online: VIEW, Loadouts, Create a Thunderstore code.",
          expect: "A big code shows and is copied. Importing it (Loadouts, Import a Thunderstore profile code), here or on another device, gets the same mods." },
        { id: "other-versions", title: "Other files", how: "In Get mods, open a mod's page, press X for Other files, then press A on an older version.",
          expect: "That version downloads and replaces yours, in the same spot, on or off as before." },
        { id: "nxm-handler", title: "Mod Manager Download", how: "Settings, Getting mods, Using your own browser: Use Turbine for Mod Manager Download. Then, in Desktop Mode, press Mod Manager Download on a Nexus mod's Files tab, once with Turbine open and once with it closed.",
          expect: "Turbine comes to the front on that game, the download shows on the status line, and the mod is added (with installer choices when it has them)." },
        { id: "nexus-free", title: "Free Nexus account", how: "With a free account, open a Nexus mod's page and press A on Open on Nexus. Also try SKSE's Install in Skyrim Special Edition.",
          expect: "The page opens in your browser, and Mod Manager Download there sends the file to Turbine. In Game Mode, the page opens inside Turbine." },
        { id: "nexus-requirements", title: "Nexus requirements", how: "Skyrim Special Edition: open the page of a Nexus mod that needs others (SkyUI needs SKSE, for example).",
          expect: "Also needs marks each one Installed, Missing (Will be added with Premium), Game DLC or Outside Nexus. Premium gets the missing ones with the mod; a free account gets their pages." },
        { id: "profile-nexus", title: "Import a loadout with Nexus mods", how: "Open a loadout file that has Nexus mods.",
          expect: "Premium: Turbine gets them too. Free: Turbine lists their pages to open and makes the loadout with what you have." },
        { id: "loot-sort", title: "Sort with the community list", how: "Skyrim Special Edition with a few plugin mods, online: on the Load order tab, press A on Sort automatically, then X on a plugin with a badge.",
          expect: "The top line says Sorted with the community sort list, and the game starts with that order. Badges like Needs cleaning mark plugins with notes, and X lists the notes." },
        { id: "nexus-key", title: "Nexus key", how: "Settings, Getting mods, Faster downloads: type your Nexus key with Steam's keyboard.",
          expect: "It shows your name and Premium or Free, and browsing Nexus Mods works. Sign out removes the key." },
        { id: "mod-updates", title: "Mod updates", how: "With an older version of a Thunderstore or Nexus mod installed, open its game.",
          expect: "Update ready shows on it. X, Update or the game menu's Update all brings the new version, in the same spot, on or off as before." },
        { id: "profiles", title: "Loadouts", how: "VIEW, Loadouts: make one, switch to it, save a loadout file, then open that file or a Thunderstore code.",
          expect: "Switching changes which mods are on right away. An import gets the mods and makes the loadout." },
        { id: "self-update", title: "Turbine updates itself", how: "Settings, Updates: Check now, Install, then Restart.",
          expect: "The new version installs and opens. With Update channel set to Pre-release in Labs, test builds show, and Go back to stable returns to the stable version." },
        { id: "archives", title: "7z and rar mods", how: "Add a .7z and a .rar mod from Downloads.",
          expect: "Both unpack and go in just like zip files." },
        { id: "heroic-art", title: "Heroic covers", how: "Look at Heroic (Epic and GOG) games on the rail.",
          expect: "They show their cover art; games without art show their initials." },
        { id: "launch-option", title: "Valheim Launch Options", how: "Valheim with a BepInEx mod: press Play and read the check, then set Launch Options in Steam as it says.",
          expect: "The check explains the one-time setting only once. After you set it, mods load when the game starts from Steam." },
        { id: "no-browser", title: "No browser warning", how: "Desktop Mode, Open Nexus in: My browser, on a system with no browser: open a Nexus page from Turbine (a mod's page, A on Open on Nexus).",
          expect: "A warning says no browser was found and lists the Discover and Add to Steam steps. After you install one, Check again finds it." },
        { id: "slow-download", title: "Slow download with no setup", how: "With no browser helper and no setup, open Nexus any way you like (Get mods, a bookmark, typing the address), find a mod and press Slow download.",
          expect: "When the file finishes, Turbine adds it to the right game or asks \"Found <file>. Add it to <game>?\" with A Add it, X Other game, Y Not a mod and B Not now. The file stays in Downloads." },
        { id: "catch-closed", title: "Downloads while Turbine is closed", how: "Close Turbine, download a mod with Slow download, then open Turbine.",
          expect: "Turbine catches up when it opens: it adds the file or asks. It never asks about a file you marked Not a mod." },
        { id: "nxm-no-key", title: "Mod Manager Download without a Nexus key", how: "With no Nexus key in Settings, Getting mods, Faster downloads, press Mod Manager Download on a Nexus mod.",
          expect: "Turbine says Mod Manager Download needs your Nexus key and suggests Slow download. A Slow download of that mod then goes into its game automatically." },
        { id: "nexus-no-key", title: "Open on Nexus when browsing fails", how: "When Get mods shows Browse ... mods on Nexus Mods: press A on Open on Nexus, then X Try again here.",
          expect: "The game's mods open in the browser, and Turbine says to use Slow download. Turbine adds the file when it lands in Downloads." },
        { id: "pointer", title: "Controller pointer", how: "Push the right stick, then press RT on a button, a mod's ON pill, a tab and a Settings row; press LT on a mod. Hold RT and move to drag. Try Game Mode and Desktop Mode, the built-in controls and an Xbox controller.",
          expect: "A brass pointer moves smoothly and outlines what it's over. RT clicks it, and LT on a mod opens its options. It hides 3 seconds after the stick stops, or at once on any other button; then LT and RT page up and down." },
        { id: "r3-click", title: "R3 is the left mouse button", how: "Show the pointer and press R3 on a mod's ON pill; hold R3 and move the right stick. Then let the pointer hide and press R3 on a mod.",
          expect: "With the pointer showing, R3 clicks like RT and holding it drags. With it hidden, the pointer appears on the highlighted mod and R3 does what A does." },
        { id: "left-stick", title: "Left stick: D-pad and scrolling", how: "On My mods, push the left stick down and hold it, then let go. Then sweep it around the edge, both ways, over a long list.",
          expect: "Pushed and held, it moves like the D-pad (one row, then repeating). Swept around, it scrolls (clockwise is down, a few rows every 30 degrees), and the highlight stays on a row you can see." },
        { id: "bumpers-tabs", title: "LB and RB are tabs", how: "Press LB and RB on a game, in Settings and on a mod page from Get mods.",
          expect: "They switch game tabs and Settings sections, and move to the previous or next mod. They never switch the game: the rail does that." },
        { id: "quick-wheel", title: "Wheel", how: "On the Load order tab, tap VIEW, press Up, then Right, then A. Then hold VIEW, push Left and let go.",
          expect: "After a tap, the wheel stays open and Sort opens. Held and pushed, it opens Games when you let go. Wedges you can't use here are dimmed, never moved." },
        { id: "tutorial", title: "Beginner tutorial", how: "Settings, Help: Beginner tutorial, Show it. Go through the five cards with A, then open it again and skip it with B.",
          expect: "It shows big pictures of the real buttons and ends on the rail with \"Pick a game to start\". It doesn't open automatically after that." },
        { id: "focus-memory", title: "The highlight comes back", how: "Highlight the third mod, open another game from the rail and come back. Press X on a mod and close the menu. Open Settings from the wheel and press B.",
          expect: "Each time, the highlight is where you left it, on the same tab." },
        { id: "rail-menu", title: "Pin and hide on the rail", how: "On the rail, press X on a game and pick Pin to the top. On a tool like Lossless Scaling, pick Hide from the rail. Settings, Help brings it back.",
          expect: "The pinned game stays at the top. The hidden one stays off the rail until you show it." },
        { id: "touch-hold", title: "Touch: hold for options", how: "Touch and hold a mod row, a Get mods card and a plugin for half a second. Swipe sideways on the tabs.",
          expect: "Holding opens that item's options, and the swipe changes the tab. The legend hides until you press a button." },
        { id: "fewer-steps", title: "Fewer presses to a mod", how: "Game Mode, a free Nexus account and a game with no mods: press A on the game on the rail, A on a mod, A on Get it on Nexus, then Slow download, then Play.",
          expect: "The game opens on Get mods with the first mod highlighted, Get it on Nexus is highlighted on its page, and Play is highlighted when the mod arrives." },
        { id: "scroll-stick", title: "Sticks while Steam's keyboard is up", how: "Open Find (Y) so Steam's keyboard shows, then move both sticks and press the triggers.",
          expect: "While Steam's keyboard is up, the sticks and triggers do nothing in Turbine." },
        { id: "md5-identify", title: "Nexus names for added files", how: "With a Nexus key, add a mod you downloaded from Nexus by hand (Add from Downloads).",
          expect: "It shows with its Nexus name and version, and gets Update ready badges like mods from Get mods." },
        { id: "overlay-desktop", title: "Status over the browser (Desktop Mode)", how: "Desktop Mode: start a Nexus download from Turbine, then stay in the browser.",
          expect: "A small Turbine card stays above the browser with the progress, then says it was added to the game and closes 6 seconds later. Its buttons work with a tap or a click." },
        { id: "overlay-gamemode", title: "Status over the browser (Game Mode)", how: "Game Mode, Labs: Open Nexus in Steam's browser. Download a mod and watch the bottom left corner.",
          expect: "The brass card shows over the browser and never takes the controller. It goes away when nothing is happening, and the Performance Overlay still works afterward." },
        { id: "gamemode-window", title: "Turbine's window in Game Mode", how: "Open Turbine in Game Mode and use it for a minute (Turbine draws through X11 on SteamOS).",
          expect: "Turbine fills the screen, looks sharp, and the controller works as usual." },
        { id: "browser-helper", title: "Browser helper (optional)", how: "Settings, Getting mods, Using your own browser: Browser helper, Set up, follow the steps, then Pair. Download a mod on Nexus.",
          expect: "The pairing page says Paired and Settings says Connected. The Nexus page shows Turbine's progress, then Added, and installer choices that work from either side." },
        { id: "steam-browser", title: "Steam's built-in browser", how: "Game Mode, Labs: Open Nexus in Steam's browser. Sign in, then use Slow download on a mod for the game on screen.",
          expect: "The file arrives in Downloads and Turbine asks to add it. If it doesn't, say in the report where the file went (or that Steam didn't download it)." },
        { id: "cyberpunk", title: "Cyberpunk 2077 mods", how: "Cyberpunk 2077: add Cyber Engine Tweaks, RED4ext and a mod that needs them, plus a REDmod mod. Press Play.",
          expect: "The check names missing frameworks and explains REDmod once. Proton settings get winmm and version, and the mods load in the game." },
        { id: "kcd-mods", title: "Kingdom Come: Deliverance mods", how: "Kingdom Come: Deliverance: add a mod from Nexus (a folder with mod.manifest and Data), reorder two mods, press Play.",
          expect: "Mods go in Mods/<name>, Mods/mod_order.txt lists them in Turbine's order, and they work in the game." },
        { id: "kcd2-mods", title: "Kingdom Come: Deliverance II mods", how: "Kingdom Come: Deliverance II: add two mods from Nexus, turn one off, press Play.",
          expect: "Mods go in the game's mods folder, mod_order.txt lists only the one that's on, and it works in the game." },
        { id: "witcher3", title: "The Witcher 3 mods", how: "The Witcher 3: add two mods, reorder them, press Play (start the game once first if it never ran).",
          expect: "Mods go in mods/modName and their order goes in mods.settings. Scripts that clash show in the check, and settings notes show after you add a mod." },
        { id: "skyrim-nexus", title: "Skyrim Special Edition from Nexus", how: "Skyrim Special Edition: get SKSE, Address Library and an SKSE plugin mod from Nexus (Mod Manager Download or Slow download).",
          expect: "SKSE goes in as the loader. Without Address Library, the check says it's missing; with it, the plugin loads." }
    ]
}
