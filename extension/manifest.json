{
  "manifest_version": 3,
  "name": "Turbine browser helper",
  "short_name": "Turbine",
  "version": "0.59",
  "description": "Sends mods you download from Nexus Mods to Turbine Mod Manager, shows install progress and choices on the page, and brings your Nexus sign-in (and, if you choose, your API key) to Turbine when you ask.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "cookies",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://*.nexusmods.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Turbine",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.nexusmods.com/*"
      ],
      "js": [
        "lib/protocol.js",
        "lib/choices.js",
        "lib/keyfind.js",
        "content/nexus.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1/pair*"
      ],
      "js": [
        "lib/protocol.js",
        "content/pair.js"
      ],
      "run_at": "document_end"
    }
  ]
}
